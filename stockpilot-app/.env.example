# URL of the deployed AI server (server/), e.g. https://stockpilot-ai.<you>.workers.dev
EXPO_PUBLIC_AI_URL=http://localhost:8787
# Must match APP_KEY on the server
EXPO_PUBLIC_APP_KEY=dev
# RevenueCat public SDK keys (Project settings → API keys). Leave empty to hide purchases.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
